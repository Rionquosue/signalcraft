#!/usr/bin/env ruby
# frozen_string_literal: true

# Creates config/signalcraft.yml and throwaway secrets for local development
# and CI. Refuses to run in production. Existing files are kept.
#
# Usage: bin/dev-config [--database-host HOST] [--database-user USER] [--database-password PASSWORD]
require "fileutils"
require "optparse"
require "securerandom"

abort "bin/dev-config is for development and test only" if ENV["RAILS_ENV"] == "production"

options = { host: "localhost", user: ENV.fetch("USER", "postgres"), password: "" }
OptionParser.new do |o|
  o.on("--database-host HOST") { |v| options[:host] = v }
  o.on("--database-user USER") { |v| options[:user] = v }
  o.on("--database-password PASSWORD") { |v| options[:password] = v }
end.parse!

config_dir = File.expand_path("../config", __dir__)
secrets_dir = File.join(config_dir, "secrets")
FileUtils.mkdir_p(secrets_dir)

secrets = {
  "database_password" => options[:password],
  "secret_key_base" => SecureRandom.hex(64),
  "encryption_primary_keys" => SecureRandom.alphanumeric(32),
  "encryption_key_derivation_salt" => SecureRandom.alphanumeric(32)
}
secrets.each do |name, value|
  path = File.join(secrets_dir, name)
  next if File.exist?(path)

  File.write(path, value)
  File.chmod(0o600, path)
end

config_path = File.join(config_dir, "signalcraft.yml")
unless File.exist?(config_path)
  File.write(config_path, <<~YAML)
    # Development configuration generated by bin/dev-config. Not for production.
    public_base_url: https://localhost
    database_host: #{options[:host]}
    database_name: signalcraft_development
    database_user: #{options[:user]}
    database_sslmode: disable
    database_password_file: secrets/database_password
    secret_key_base_file: secrets/secret_key_base
    encryption_primary_keys_file: secrets/encryption_primary_keys
    encryption_key_derivation_salt_file: secrets/encryption_key_derivation_salt
    workspace_media_quota_bytes: 1073741824
  YAML
end

puts "Development configuration ready in #{config_dir}"
