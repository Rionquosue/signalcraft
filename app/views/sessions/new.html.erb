<% content_for :title, "Sign in · SignalCraft" %>

<section class="card sign-in">
  <h1>Sign in</h1>
  <%= form_with url: session_path, class: "form" do |form| %>
    <%= form.label :email, "E-mail address" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
                                 value: params[:email] %>

    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>

    <%= form.submit "Sign in", class: "button primary" %>
  <% end %>
</section>
