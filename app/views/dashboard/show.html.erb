<% content_for :title, "Publishing queue · SignalCraft" %>

<div class="workhead">
  <div>
    <h1>Publishing queue</h1>
    <% if @workspace %>
      <p class="sub"><%= @workspace.name %> · Display: <%= @workspace.default_timezone %></p>
    <% end %>
  </div>
  <% if @workspace && @can_publish && @accounts.any? %>
    <%= link_to "New post", new_post_path(workspace_id: @workspace.id), class: "button primary" %>
  <% end %>
</div>

<% if params[:retry_entry].present? && @can_publish %>
  <% retry_queue = @accounts.filter_map(&:channel_queue).find { |q| @waiting_ids.fetch(q.id, []).include?(params[:retry_entry]) } %>
  <% if retry_queue %>
    <p class="banner">
      <%= link_to "Try the move again", new_channel_queue_move_path(retry_queue, entry_id: params[:retry_entry],
                                                                     direction: params[:retry_direction]) %>
    </p>
  <% end %>
<% end %>

<% if @workspace.nil? %>
  <div class="empty">
    <p>You're not a member of any workspace yet.</p>
    <p class="sub">Ask a workspace owner to invite you.</p>
  </div>
<% elsif @accounts.empty? %>
  <div class="empty">
    <p>Connect an account to start scheduling.</p>
    <p class="sub">Account connections arrive with the first addons.</p>
  </div>
<% else %>
  <div class="board">
    <% @accounts.each do |account| %>
      <%= render "column", account: account, queue: account.channel_queue,
                           targets: @targets_by_account.fetch(account.id, []),
                           waiting: @waiting_ids.fetch(account.channel_queue&.id, []) %>
    <% end %>
  </div>
<% end %>
